# Chave da API OpenAI (obrigatória para o chat com IA)
OPENAI_API_KEY=sk-sua-chave-aqui

# Modelo OpenAI (opcional — padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Usuário do painel administrativo
ADMIN_USERNAME=admin

# Senha admin — USE HASH (recomendado). Gere com:
#   cd server && node scripts/hash-password.js "sua-senha-forte"
ADMIN_PASSWORD_HASH=$2a$12$exemplo.substitua.pelo.hash.gerado

# Legado (somente 1ª migração — remova após gerar hash)
# ADMIN_PASSWORD=sua-senha-temporaria

# Segredo para tokens de sessão (obrigatório em produção)
SESSION_SECRET=altere-este-segredo-aleatorio-longo

# Porta do servidor (opcional — padrão: 3001)
PORT=3001

# Ambiente: development | production
NODE_ENV=production

# Ative atrás de proxy reverso (Nginx, Cloudflare, Render)
TRUST_PROXY=true

# Origens permitidas (CORS), separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3001,https://www.novaeraveiculosbm.com.br,https://novaeraveiculosbm.com.br
